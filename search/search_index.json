{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\ud83d\udca1 MicroServer \ud504\ub808\uc784\uc6cc\ud06c","text":""},{"location":"#si","title":"\ud83c\udfaf \uae08\uc735 SI \ud504\ub85c\uc81d\ud2b8\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uc218\ud589\ud558\uae30 \uc704\ud55c \ud45c\uc900 \uac1c\ubc1c \ud504\ub808\uc784\uc6cc\ud06c","text":"<p>MicroServer\ub294 \uae08\uc735 SI \ud504\ub85c\uc81d\ud2b8\uc5d0\uc11c \ubc18\ubcf5\uc801\uc73c\ub85c \ud544\uc694\ud55c \uac1c\ubc1c \ud658\uacbd, \uacf5\ud1b5 \uae30\ub2a5, \uc804\ubb38 \uc5f0\uacc4, \ubcf4\uc548 \ubc0f \uc6b4\uc601 \uae30\ub2a5\uc744 \ud45c\uc900\ud654\ud558\uc5ec \uc81c\uacf5\ud558\ub294 Spring Boot \uae30\ubc18 \ud504\ub808\uc784\uc6cc\ud06c\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ubb38\uc11c\ub294 MicroServer\ub97c \ucc98\uc74c\ubd80\ud130 \ub2e4\uc2dc \uad6c\ucd95\ud558\uba74\uc11c \uac01 \ub2e8\uacc4\uc758 \uc124\uacc4, \uad6c\ud604, \uac80\uc99d \ubc0f \uc6b4\uc601 \ubc29\ubc95\uc744 \ud568\uaed8 \uc815\ub9ac\ud558\uae30 \uc704\ud55c \uac00\uc774\ub4dc\uc785\ub2c8\ub2e4.</p>"},{"location":"#_1","title":"\ud604\uc7ac \uc0c1\ud0dc","text":"<p>MkDocs \uae30\ubcf8 \ud658\uacbd\uc744 \uad6c\uc131\ud558\uace0 \uc804\uccb4 \ubb38\uc11c \uad6c\uc870\ub97c \uc124\uacc4\ud558\ub294 \ub2e8\uacc4\uc785\ub2c8\ub2e4.</p>"},{"location":"architecture/admin_module_guide/","title":"Admin Module","text":"<p>\uc900\ube44 \uc911</p> <p>\uad00\ub9ac\uc790 \ubaa8\ub4c8\uc758 \uad6c\uc870\uc640 \uc5ed\ud560\uc744 \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"architecture/common_module_guide/","title":"Common Module","text":"<p>\uc900\ube44 \uc911</p> <p>\uacf5\ud1b5 \uae30\ub2a5 \ub77c\uc774\ube0c\ub7ec\ub9ac \uad6c\uc870\uc640 \uc5ed\ud560\uc744 \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"architecture/microserver_architecture_overview_guide/","title":"MicroServer Architecture","text":"<p>\uc900\ube44 \uc911</p> <p>MicroServer \uc804\uccb4 \uc544\ud0a4\ud14d\ucc98\ub97c \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"architecture/multi_module_architecture_guide/","title":"\uba40\ud2f0\ubaa8\ub4c8 \uad6c\uc870","text":"<p>\uc900\ube44 \uc911</p> <p>Maven \uae30\ubc18 MicroServer \uba40\ud2f0\ubaa8\ub4c8 \uad6c\uc870\ub97c \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"architecture/relay_client_guide/","title":"Relay Client","text":"<p>\uc900\ube44 \uc911</p> <p>\uc804\ubb38 \uc1a1\uc2e0 \ud074\ub77c\uc774\uc5b8\ud2b8 \ubaa8\ub4c8\uc744 \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"architecture/relay_server_guide/","title":"Relay Server","text":"<p>\uc900\ube44 \uc911</p> <p>\uc804\ubb38 \uc911\uacc4 \uc11c\ubc84 \ubaa8\ub4c8\uc744 \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"architecture/runtime_module_guide/","title":"Runtime Module","text":"<p>\uc900\ube44 \uc911</p> <p>\ube44\uc988\ub2c8\uc2a4 \uc5c5\ubb34 \ucc98\ub9ac Runtime \ubaa8\ub4c8\uc744 \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"basic/microserver_basic_overview_guide/","title":"\uae30\ucd08 \ud559\uc2b5","text":"<p>\uc900\ube44 \uc911</p> <p>Spring Boot, Web, REST API, Database, Security \ub4f1 \uad6c\ucd95\uc5d0 \ud544\uc694\ud55c \ud575\uc2ec \uac1c\ub150\uc744 \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"build/microserver_build_overview_guide/","title":"MicroServer \uad6c\ucd95","text":"<p>\uc900\ube44 \uc911</p> <p>MicroServer\ub97c \ucc98\uc74c\ubd80\ud130 \ub2e8\uacc4\ubcc4\ub85c \uad6c\ucd95\ud558\ub294 \uc2e4\uc2b5 \uac00\uc774\ub4dc\ub97c \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"build/step01_project_setup_guide/","title":"01. \ud504\ub85c\uc81d\ud2b8 \uae30\ubcf8 \uad6c\uc131","text":"<p>\uc900\ube44 \uc911</p> <p>Spring Boot \ud504\ub85c\uc81d\ud2b8\uc640 \uae30\ubcf8 \uad6c\uc870\ub97c \uad6c\uc131\ud558\ub294 \ub0b4\uc6a9\uc744 \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"build/step02_web_setup_guide/","title":"02. Web \uae30\ubcf8 \uad6c\uc131","text":"<p>\uc900\ube44 \uc911</p> <p>Spring MVC, REST API, Filter, Request/Response \uad6c\uc870\ub97c \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"build/step03_datasource_setup_guide/","title":"03. DataSource \uc5f0\ub3d9","text":"<p>\uc900\ube44 \uc911</p> <p>DataSource, HikariCP, MyBatis/JPA, Transaction \uad6c\uc131\uc744 \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"build/step04_spring_security_guide/","title":"04. Spring Security","text":"<p>\uc900\ube44 \uc911</p> <p>\uc778\uc99d, \uc778\uac00, \uc138\uc158/JWT \ub4f1 Spring Security \uad6c\uc131\uc744 \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"build/step05_common_processing_guide/","title":"05. \uacf5\ud1b5 \ucc98\ub9ac","text":"<p>\uc900\ube44 \uc911</p> <p>Exception, \uacf5\ud1b5 Response, Validation, \uc554\ubcf5\ud638\ud654 \ub4f1 \uacf5\ud1b5 \ucc98\ub9ac\ub97c \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"build/step06_logging_guide/","title":"06. Logging","text":"<p>\uc900\ube44 \uc911</p> <p>Logback, MDC, Request Logging \ub4f1 \ub85c\uae45 \uad6c\uc131\uc744 \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"build/step07_api_documentation_guide/","title":"07. API \ubb38\uc11c","text":"<p>\uc900\ube44 \uc911</p> <p>SpringDoc/OpenAPI \uae30\ubc18 API \ubb38\uc11c\ud654\ub97c \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"build/step08_web_view_guide/","title":"08. Web \ud654\uba74","text":"<p>\uc900\ube44 \uc911</p> <p>Thymeleaf, Layout, Static Resource, Bootstrap \uad6c\uc131\uc744 \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"build/step09_message_integration_guide/","title":"09. \uc804\ubb38 \uc5f0\uacc4","text":"<p>\uc900\ube44 \uc911</p> <p>MCA/EAI/FEP \uc804\ubb38 \uc5f0\uacc4\uc640 Message Builder/Parser \uad6c\uc131\uc744 \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"build/step10_admin_guide/","title":"10. \uad00\ub9ac\uc790 \uae30\ub2a5","text":"<p>\uc900\ube44 \uc911</p> <p>\uacf5\ud1b5\ucf54\ub4dc, \uba54\ub274, \uc0ac\uc6a9\uc790, \uc804\ubb38 \uba54\uc2dc\uc9c0 \ub4f1 \uad00\ub9ac\uc790 \uae30\ub2a5\uc744 \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"operation/actuator_healthcheck_guide/","title":"Actuator / Health Check","text":"<p>\uc900\ube44 \uc911</p> <p>Spring Boot Actuator\uc640 Health Check \uad6c\uc131\uc744 \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"operation/build_guide/","title":"Build","text":"<p>\uc900\ube44 \uc911</p> <p>MicroServer \ube4c\ub4dc \ubc29\ubc95\uc744 \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"operation/deployment_guide/","title":"\ubc30\ud3ec","text":"<p>\uc900\ube44 \uc911</p> <p>MicroServer \ubc30\ud3ec \ubc29\ubc95\uc744 \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"operation/environment_configuration_guide/","title":"\ud658\uacbd\ubcc4 \uc124\uc815","text":"<p>\uc900\ube44 \uc911</p> <p>Local/Dev/Staging/Prod \ud658\uacbd\ubcc4 \uc124\uc815 \uad00\ub9ac \ubc29\ubc95\uc744 \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"operation/operation_deployment_overview_guide/","title":"\uc6b4\uc601 \ubc0f \ubc30\ud3ec","text":"<p>\uc900\ube44 \uc911</p> <p>MicroServer \uc6b4\uc601 \ubc0f \ubc30\ud3ec \uc804\ubc18\uc744 \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"project_setup/project_environment_setup_overview_guide/","title":"\ud504\ub85c\uc81d\ud2b8 \ud658\uacbd \uad6c\uc131","text":"<p>\uc900\ube44 \uc911</p> <p>Java, IDE, Git/GitHub \ub4f1 MicroServer \uac1c\ubc1c\uc744 \uc704\ud55c \ud504\ub85c\uc81d\ud2b8 \ud658\uacbd \uad6c\uc131\uc744 \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"reference/project_structure_reference/","title":"\ud504\ub85c\uc81d\ud2b8 \uc804\uccb4 \uad6c\uc870","text":"<p>\uc900\ube44 \uc911</p> <p>\ucd5c\uc885 MicroServer \ud504\ub85c\uc81d\ud2b8 \uad6c\uc870\ub97c \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"reference/reference_overview/","title":"Reference","text":"<p>\uc900\ube44 \uc911</p> <p>MicroServer \uac1c\ubc1c\uacfc \uc6b4\uc601\uc5d0 \ud544\uc694\ud55c \ucc38\uace0 \uc790\ub8cc\ub97c \uc815\ub9ac\ud569\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"reference/resources/","title":"\ucc38\uace0 \uc790\ub8cc","text":"<p>\uc900\ube44 \uc911</p> <p>\uacf5\uc2dd \ubb38\uc11c\uc640 \ucc38\uace0 \ub9c1\ud06c\ub97c \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"reference/troubleshooting/","title":"Troubleshooting","text":"<p>\uc900\ube44 \uc911</p> <p>\uad6c\ucd95 \uacfc\uc815\uc5d0\uc11c \ubc1c\uc0dd\ud55c \ubb38\uc81c\uc640 \ud574\uacb0 \ubc29\ubc95\uc744 \ub204\uc801\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"roadmap/microserver_roadmap/","title":"MicroServer \uad6c\ucd95 \ub85c\ub4dc\ub9f5","text":"<p>\uc900\ube44 \uc911</p> <p>MicroServer \uc804\uccb4 \uad6c\ucd95 \uc21c\uc11c\uc640 \ub2e8\uacc4\ubcc4 \ubaa9\ud45c\ub97c \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"spring_cloud/service_discovery_eureka_guide/","title":"Service Discovery / Eureka","text":"<p>\uc900\ube44 \uc911</p> <p>Eureka Server/Client\uc640 \uc11c\ube44\uc2a4 \ub514\uc2a4\ucee4\ubc84\ub9ac\ub97c \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"spring_cloud/spring_cloud_gateway_guide/","title":"Spring Cloud Gateway","text":"<p>\uc900\ube44 \uc911</p> <p>Gateway \uad6c\ucd95, Routing, Filter \ub4f1\uc744 \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"spring_cloud/spring_cloud_overview_guide/","title":"Spring Cloud","text":"<p>\uc900\ube44 \uc911</p> <p>MicroServer\uc5d0\uc11c \uc0ac\uc6a9\ud558\ub294 Spring Cloud \uad00\ub828 \ub0b4\uc6a9\uc744 \uc815\ub9ac\ud560 \uc608\uc815\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"},{"location":"spring_cloud/spring_webflux_guide/","title":"Spring WebFlux","text":"<p>\uc900\ube44 \uc911</p> <p>Reactive Programming\uacfc Spring WebFlux \ub0b4\uc6a9\uc744 \uc900\ube44 \uc911\uc785\ub2c8\ub2e4.</p> <p>\uc774 \ud398\uc774\uc9c0\ub294 \uc804\uccb4 \ubaa9\ucc28\uc640 \ub9c1\ud06c \uad6c\uc870\ub97c \uba3c\uc800 \uad6c\uc131\ud558\uae30 \uc704\ud574 \uc0dd\uc131\ud55c \uc784\uc2dc \ud398\uc774\uc9c0\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uc740 MicroServer \uad6c\ucd95 \uc9c4\ud589\uc5d0 \ub9de\ucdb0 \ub2e8\uacc4\uc801\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4.</p>"}]}